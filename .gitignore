# Unreal-generated project and plugin data.
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/**/Binaries/
/Plugins/**/DerivedDataCache/
/Plugins/**/Intermediate/
/Plugins/**/Saved/

# Generated platform build data; retain source icons and packaging lists.
/Build/**
!/Build/**/
!/Build/**/*.ico
!/Build/**/PakBlacklist*.txt
!/Build/**/PakDenylist*.txt
!/Build/**/PakWhitelist*.txt
!/Build/**/PakAllowlist*.txt

# Local build, staging, packaging, and temporary download destinations.
/Artifacts/
/StagedBuilds/
/Windows/
/WindowsNoEditor/
/Temp/
/Downloads/
/Engine/

# Regenerable IDE projects and local editor settings.
.vs/
.vscode/
.idea/
*.sln
*.slnx
